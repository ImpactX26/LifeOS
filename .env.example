# Copy to .env and fill in locally. .env is gitignored. NEVER commit real keys.
# Keys are only read by the Python backend. Never put them in frontend/ or in any VITE_* variable
# (Vite ships VITE_* values to the browser).

# Each teammate uses their OWN Gemini key during dev (free-tier rate limits are per key/project).
# The demo laptop uses a dedicated key that nobody else touches.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Shared, small monthly quota. Only D makes live calls; everyone else runs on cached/seeded data.
SERPAPI_API_KEY=

# Frozen demo clock so "next weekend" always means the same dates (Sat 10 - Sun 11 Oct 2026).
LIFEOS_TODAY=2026-10-08
